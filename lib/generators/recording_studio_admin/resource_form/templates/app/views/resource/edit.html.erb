<%%= render layout: "recording_studio_admin/shared/page_shell" do %>
  <%%= render FlatPack::PageNav::Component.new(anchor_url: page_nav_anchor_url(default: recording_studio_admin_context.admin_screen_path("<%= screen_key %>")), class: "mb-4") %>

  <%%= render FlatPack::PageTitle::Component.new(title: "Edit <%= singular_name.humanize.downcase %>", subtitle: <%= instance_name %>.<%= display_field.name %>.to_s) %>

  <%%= form_with model: [:<%= namespace_name %>, <%= instance_name %>], class: "space-y-4" do |form| %>
<% fields.each do |field| -%>
<% if field.email? -%>
    <%%= render FlatPack::EmailInput::Component.new(
      name: "<%= model_param_key %>[<%= field.name %>]",
      label: "<%= field.label %>",
      value: <%= instance_name %>.<%= field.name %>,
      error: <%= instance_name %>.errors[:<%= field.name %>].to_sentence.presence
    ) %>
<% elsif field.select? -%>
    <div class="space-y-1">
      <%%= label_tag "<%= model_param_key %>_<%= field.name %>", "<%= field.label %>", class: "text-sm font-medium text-(--surface-content-color)" %>
      <%%= render FlatPack::Select::Component.new(
        name: "<%= model_param_key %>[<%= field.name %>]",
        options: [],
        value: <%= instance_name %>.<%= field.name %>,
        placeholder: "Select <%= field.label.downcase %>"
      ) %>
      <%% if <%= instance_name %>.errors[:<%= field.name %>].any? %>
        <p class="text-sm text-[var(--color-danger-background-color)]"><%%= <%= instance_name %>.errors[:<%= field.name %>].to_sentence %></p>
      <%% end %>
    </div>
<% elsif field.boolean? -%>
    <%%= hidden_field_tag "<%= model_param_key %>[<%= field.name %>]", "0" %>
    <%%= render FlatPack::Checkbox::Component.new(
      name: "<%= model_param_key %>[<%= field.name %>]",
      value: "1",
      checked: <%= instance_name %>.<%= field.name %>,
      label: "<%= field.label %>"
    ) %>
<% else -%>
    <%%= render FlatPack::TextInput::Component.new(
      name: "<%= model_param_key %>[<%= field.name %>]",
      label: "<%= field.label %>",
      value: <%= instance_name %>.<%= field.name %>,
      error: <%= instance_name %>.errors[:<%= field.name %>].to_sentence.presence
    ) %>
<% end -%>

<% end -%>
    <div class="flex items-center gap-2 pt-2">
      <%%= render FlatPack::Button::Component.new(text: "Save", type: :submit, style: :primary) %>
    </div>
  <%% end %>
<%% end %>