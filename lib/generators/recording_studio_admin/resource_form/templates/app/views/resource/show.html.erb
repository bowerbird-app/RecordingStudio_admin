<%% recording_studio_admin_page_heading(
     title: "<%= singular_name.humanize %> details",
     anchor: page_nav_anchor_url(default: recording_studio_admin_context.admin_screen_path("<%= screen_key %>")),
     subtitle: <%= instance_name %>.<%= display_field.name %>.to_s
   ) %>
<% if route_actions.include?("edit") -%>
<%% if @edit_<%= singular_name %>_action %>
  <%% register_page_nav "Edit", preserve_anchor_url(@edit_<%= singular_name %>_action.url), role: :primary %>
<%% end %>
<% end -%>
<%%= render layout: "recording_studio_admin/shared/page_shell" do %>
  <%% unless recording_studio_admin_default_layout? %>
    <%%= render "recording_studio_admin/shared/page_nav" %>
    <%%= render FlatPack::PageTitle::Component.new(title: "<%= singular_name.humanize %> details", subtitle: <%= instance_name %>.<%= display_field.name %>.to_s) %>
  <%% end %>

  <%% attribute_rows = <%= instance_name %>.attributes.sort_by { |name, _| name }.map do |name, value|
       formatted_value = case value
                         when Time, DateTime, ActiveSupport::TimeWithZone
                           value.strftime("%b %-d, %Y %l:%M%P")
                         when Date
                           value.strftime("%b %-d, %Y")
                         when nil
                           "-"
                         else
                           value.to_s
                         end

       {
         attribute: name.titleize,
         value: formatted_value
       }
     end %>

  <div class="space-y-4">
    <%%= render FlatPack::Table::Component.new(data: attribute_rows, class: "text-sm") do |table| %>
      <%% table.column(title: "Attribute") { |attribute_row| attribute_row.fetch(:attribute) } %>
      <%% table.column(title: "Value") { |attribute_row| attribute_row.fetch(:value) } %>
    <%% end %>
  </div>
<%% end %>
