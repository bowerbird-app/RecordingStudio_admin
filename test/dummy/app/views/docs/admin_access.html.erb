<div class="mx-auto flex w-full max-w-6xl flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Admin access",
    subtitle: "How RecordingStudioAdmin resolves access using RecordingStudioAccessible, an access recording, and section availability.",
    variant: :h1
  ) %>

  <%= render FlatPack::SectionTitle::Component.new(
    title: "Access flow",
    subtitle: "Every admin request resolves a target recording, then checks the current actor against RecordingStudioAccessible.",
  ) %>

  <%= render FlatPack::CodeBlock::Component.new(
    language: :ruby,
    code: <<~'CODE'
      RecordingStudioAdmin.configure do |config|
        config.authentication_method = :authenticate_user!
        config.current_actor_method = :current_user

        # Return the recording that defines this admin scope.
        config.access_recording_resolver = lambda do |_context|
          admin_root = AdminRoot.find_by(name: "Admin")
          next unless admin_root

          RecordingStudio::Recording.find_by(recordable: admin_root, trashed_at: nil)
        end
      end

      # Later, Authorization.authorize! calls:
      RecordingStudioAccessible.authorized?(
        actor: current_user,
        recording: recording_studio_admin_context.access_recording,
        role: RecordingStudioAdmin.configuration.required_access_role
      )
    CODE
  ) %>

  <%= render FlatPack::SectionTitle::Component.new(
    title: "Root admin and admin sections",
    subtitle: "AdminRoot is a convenient host-app recordable, and AdminSection can back individual section pages under that root.",
  ) %>

  <%= render FlatPack::CodeBlock::Component.new(
    language: :ruby,
    code: <<~'CODE'
      class AdminRoot < ApplicationRecord
        include RecordingStudio::Recordable
        include RecordingStudioAccessible::AllowsAccessibleChildren
        include RecordingStudioAdmin::AllowsAdminSections

        recording_studio_recordable label: "Admin", root: true
        recording_studio_accessible_children :access

        recording_studio_admin_sections do
          section :root
        end
      end

      class AdminSection < ApplicationRecord
        include RecordingStudio::Recordable
        include RecordingStudioAccessible::AllowsAccessibleChildren

        recording_studio_recordable label: "Admin section", root: false,
          allowed_parent_types: ["AdminRoot"]
        recording_studio_accessible_children :access
      end
    CODE
  ) %>

  <%= render FlatPack::SectionTitle::Component.new(
    title: "Section and screen visibility",
    subtitle: "After authorization, the context resolves only the sections and screens enabled for the current recording, placement, and optional parent filters.",
  ) %>

  <%= render FlatPack::CodeBlock::Component.new(
    language: :ruby,
    code: <<~'CODE'
      root_sections = recording_studio_admin_context.available_admin_sections(
        recording: recording_studio_admin_access_recording
      )

      nav_items = recording_studio_admin_context.available_admin_items(
        recording: recording_studio_admin_access_recording,
        placement: :all,
        include: %i[sections screens]
      )

      # The generated /admin/root page uses these results to render
      # section links and search across both sections and screens.
    CODE
  ) %>

  <%= render FlatPack::SectionTitle::Component.new(
    title: "Three separate decisions",
    subtitle: "The refactored engine keeps authorization, section enablement, and section-backed recordables separate.",
  ) %>

  <%= render FlatPack::CodeBlock::Component.new(
    language: :ruby,
    code: <<~'CODE'
      # 1. Access recording: can the actor use the mounted admin UI at all?
      recording_studio_admin_context.access_recording

      # 2. Enabled sections: which registered sections should this recordable expose?
      recording_studio_admin_context.available_admin_sections

      # 3. Section recordable: optional RecordingStudio object created/resolved
      #    after a section page is opened.
      class RootSection < RecordingStudioAdmin::Section
        recordable "AdminSection",
          find_or_create_by: -> { { key: "root", name: "Admin section" } },
          parent: -> { AdminRoot.find_or_create_by!(name: "Admin") }
      end
    CODE
  ) %>

  <p class="text-sm text-(--body-muted-content-color)">
    In short: access is checked against the resolved admin recording first, then the UI only renders sections enabled by
    the current recording's recordable type.
  </p>
</div>
