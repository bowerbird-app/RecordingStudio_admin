<div class="mx-auto flex w-full max-w-6xl flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Admin root",
    subtitle: "AdminRoot is a convenience recordable for bootstrapping a default admin area, not a special requirement in RecordingStudio.",
    variant: :h1
  ) %>

  <%= render FlatPack::SectionTitle::Component.new(
    title: "What AdminRoot is",
    subtitle: "The generator gives you an AdminRoot model so you can stand up an admin scope quickly.",
  ) %>

  <%= render FlatPack::CodeBlock::Component.new(
    language: :ruby,
    code: <<~'CODE'
      class AdminRoot < ApplicationRecord
        include RecordingStudio::Recordable
        include RecordingStudioAdmin::AllowsAdminSections

        recording_studio_recordable label: "Admin", root: true, shared: false
        RecordingStudio.enable_capability(:accessible, on: self)

        recording_studio_admin_sections do
          section :root
        end
      end
    CODE
  ) %>

  <%= render FlatPack::SectionTitle::Component.new(
    title: "What AdminRoot is not",
    subtitle: "It is not a privileged engine-only type. RecordingStudioAdmin works with whichever recording your resolver returns.",
  ) %>

  <%= render FlatPack::CodeBlock::Component.new(
    language: :ruby,
    code: <<~'CODE'
      RecordingStudioAdmin.configure do |config|
        config.access_recording_resolver = lambda do |_context|
          admin_root = AdminRoot.find_by(name: "Admin")
          next unless admin_root

          RecordingStudio::Recording.find_by(recordable: admin_root, trashed_at: nil)
        end
      end
    CODE
  ) %>

  <%= render FlatPack::SectionTitle::Component.new(
    title: "What the generator adds",
    subtitle: "The admin_root generator is host-app scaffolding for a sidebar-friendly admin landing page, not a hidden engine requirement.",
  ) %>

  <%= render FlatPack::CodeBlock::Component.new(
    language: :ruby,
    code: <<~'CODE'
      # Generated app files include:
      # app/models/admin_root.rb
      # app/controllers/admin/base_controller.rb
      # app/controllers/admin/root_controller.rb
      # app/views/admin/root/show.html.erb
      # app/javascript/controllers/admin/root_search_controller.js
    CODE
  ) %>

  <%= render FlatPack::SectionTitle::Component.new(
    title: "Generated admin root behavior",
    subtitle: "The generated host-app /admin/root page lists available sections and searches across both sections and screens.",
  ) %>

  <%= render FlatPack::CodeBlock::Component.new(
    language: :ruby,
    code: <<~'CODE'
      admin_sections = recording_studio_admin_context.available_admin_sections(
        recording: recording_studio_admin_access_recording
      )

      admin_search_results = recording_studio_admin_context.available_admin_items(
        recording: recording_studio_admin_access_recording,
        include: %i[sections screens]
      )
    CODE
  ) %>

  <p class="text-sm text-(--body-muted-content-color)">
    Use AdminRoot when a host app wants a simple sitewide admin landing page. If your product uses another hierarchy,
    point the access resolver at that recording instead and keep using the same section and screen DSL.
  </p>
</div>
