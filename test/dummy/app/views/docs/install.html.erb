<div class="mx-auto flex w-full max-w-6xl flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Install",
    subtitle: "After adding the gem, complete these host-app steps to mount, configure, and optionally scaffold RecordingStudioAdmin.",
    variant: :h1
  ) %>

  <%= render FlatPack::SectionTitle::Component.new(
    title: "Step 1",
    subtitle: "Run the install generator (required)",
  ) %>

  <%= render FlatPack::CodeBlock::Component.new(
    language: :bash,
    code: <<~CODE
      bin/rails generate recording_studio_admin:install
      # Optional custom mount path:
      # bin/rails generate recording_studio_admin:install --mount_path=/reporting/admin
    CODE
  ) %>

  <%= render FlatPack::SectionTitle::Component.new(
    title: "Step 2",
    subtitle: "Confirm routes, initializer, and the config-vs-registration split generated by step 1",
  ) %>

  <%= render FlatPack::CodeBlock::Component.new(
    language: :ruby,
    code: <<~'CODE'
      # config/routes.rb
      mount RecordingStudioAccessible::Engine, at: "/admin/access"
      mount RecordingStudioAdmin::Engine, at: "/admin"

      # config/initializers/recording_studio_admin.rb
      RecordingStudioAdmin.configure do |config|
        config.default_mount_path = "/admin"
        config.authentication_method = :authenticate_user!
        config.current_actor_method = :current_user
        config.access_recording_resolver = lambda do |_context|
          admin_root = AdminRoot.find_by(name: "Admin")
          next unless admin_root

          RecordingStudio::Recording.find_by(recordable: admin_root, trashed_at: nil)
        end
      end

      # Registration belongs in to_prepare so Rails reloads safely.
      Rails.application.config.to_prepare do
        RecordingStudioAdmin.register_screen(AdminScreens::ApiRequests)
        RecordingStudioAdmin.register_section(AdminScreens::RootSection)
      end
    CODE
  ) %>

  <%= render FlatPack::SectionTitle::Component.new(
    title: "Step 3",
    subtitle: "If you use Tailwind, keep the generator-added @source lines so engine classes compile",
  ) %>

  <%= render FlatPack::CodeBlock::Component.new(
    language: :css,
    code: <<~'CODE'
      /* app/assets/tailwind/application.css */
      @source "../../vendor/bundle/**/recording_studio_admin/app/views/**/*.erb";
      @source "../../vendor/bundle/**/recording_studio_admin/app/components/**/*.{rb,erb}";
      @source "../../vendor/bundle/**/flat_pack/app/components/**/*.{rb,erb}";
    CODE
  ) %>

  <%= render FlatPack::SectionTitle::Component.new(
    title: "Step 4",
    subtitle: "Validate the mounted admin endpoints and the optional generated admin root",
  ) %>

  <%= render FlatPack::CodeBlock::Component.new(
    language: :text,
    code: <<~CODE
      /admin
      /admin/sections
      /admin/sections/:key
      /admin/screens/:key

      # Optional, when you also run the admin_root generator:
      /admin/root
    CODE
  ) %>

  <p class="text-sm text-(--body-muted-content-color)">
    The install generator mounts the engine and creates the initializer. The separate
    <span class="font-mono">recording_studio_admin:admin_root</span> generator adds host-app admin scaffolding like
    <span class="font-mono">AdminRoot</span>, <span class="font-mono">Admin::BaseController</span>, and the searchable
    <span class="font-mono">/admin/root</span> page shown in this dummy app.
  </p>
</div>
