<div class="mx-auto flex w-full max-w-6xl flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Recordable types",
    subtitle: "The table below comes from RecordingStudio.recordable_declarations and v3 parent/root introspection.",
    variant: :h1
  ) %>

  <% if @recordable_types.any? %>
    <%= render FlatPack::Table::Component.new(data: @recordable_types, class: "text-sm") do |table| %>
      <% table.column(title: "Type") { |recordable_type| recordable_type.fetch(:label) } %>
      <% table.column(title: "Role") { |recordable_type| recordable_type.fetch(:root) ? "Root" : "Child" } %>
      <% table.column(title: "Allowed parents") do |recordable_type|
           recordable_type.fetch(:allowed_parent_types).presence&.join(", ") || "None"
         end %>
      <% table.column(title: "Recording links") do |recordable_type|
           pluralize(recordable_type.fetch(:recordings_count), "recording")
         end %>
      <% table.column(title: "Database records") do |recordable_type|
           pluralize(recordable_type.fetch(:recordables_count), "recordable")
         end %>
      <% table.column(title: "Source") { |recordable_type| recordable_type.fetch(:source) } %>
    <% end %>
  <% else %>
    <p class="text-sm text-(--surface-muted-content-color)">No recordable types are configured.</p>
  <% end %>
</div>