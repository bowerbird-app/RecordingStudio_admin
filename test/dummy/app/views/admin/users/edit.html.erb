<%= render layout: "recording_studio_admin/shared/page_shell" do %>
  <% recording_studio_page_nav(
    title: "Edit user",
    page_nav_anchor_url: page_nav_anchor_url(default: recording_studio_admin_context.admin_screen_path("users"))
  ) %>

  <%= render FlatPack::PageTitle::Component.new(title: "Edit user", subtitle: @user.email) %>

  <%= form_with model: [:admin, @user], class: "space-y-4" do |form| %>
    <%= render FlatPack::EmailInput::Component.new(
      name: "user[email]",
      label: "Email",
      value: @user.email,
      error: @user.errors[:email].to_sentence.presence
    ) %>

    <div class="flex items-center gap-2 pt-2">
      <%= render FlatPack::Button::Component.new(text: "Save", type: :submit, style: :primary) %>
    </div>
  <% end %>
<% end %>