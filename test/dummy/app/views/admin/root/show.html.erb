<% admin_sections = recording_studio_admin_context.available_admin_sections(recording: recording_studio_admin_access_recording, placement: :root) %>
<% admin_search_query = params[:q].to_s.strip %>
<% admin_search_results = recording_studio_admin_context.available_admin_items(
     recording: recording_studio_admin_access_recording,
     placement: :root,
     parent: :root
   ) %>
<% normalized_admin_search_query = admin_search_query.downcase %>
<% matching_admin_search_results = if admin_search_query.present?
     admin_search_results.count { |item| item.search_text.include?(normalized_admin_search_query) }
   else
     0
   end %>

<%= render FlatPack::PageNav::Component.new(anchor_url: page_nav_anchor_url, class: "mb-4") %>

<%= render FlatPack::PageTitle::Component.new(title: "Admin", subtitle: "Manage and monitor your application") %>

<div class="space-y-4" data-controller="admin--root-search" data-action="input->admin--root-search#filter search->admin--root-search#filter">
  <form action="<%= request.path %>" method="get" class="space-y-4">
    <% if params[:anchor_url].present? %>
      <%= hidden_field_tag :anchor_url, params[:anchor_url] %>
    <% end %>

    <%= render FlatPack::SearchInput::Component.new(
      name: :q,
      value: admin_search_query,
      placeholder: "Search",
      data: {
        admin__root_search_target: "input"
      }
    ) %>
  </form>

  <% if admin_search_results.any? %>
    <div data-admin--root-search-target="results" <%= "hidden" unless admin_search_query.present? %>>
      <%= render FlatPack::List::Component.new(divider: true, class: "w-full") do %>
        <% admin_search_results.each do |item| %>
          <% item_matches_search = admin_search_query.present? && item.search_text.include?(normalized_admin_search_query) %>
          <% item_options = {
               href: preserve_anchor_url(item.url),
               hover: true,
               hidden: !item_matches_search,
               data: {
                 admin__root_search_target: "item",
                 search_text: item.search_text
               }
             } %>
          <% if item.icon.present? %>
            <% item_options[:leading] = render(FlatPack::Shared::IconComponent.new(name: item.icon, size: :md, class: "text-[var(--surface-muted-content-color)]")) %>
          <% end %>
          <%= render FlatPack::List::Item.new(**item_options) do %>
            <div class="flex items-start justify-between gap-3">
              <div class="flex min-w-0 flex-1 flex-col gap-1">
                <span><%= item.title %></span>
                <% if item.subtitle.present? %>
                  <span class="text-sm text-(--surface-muted-content-color)"><%= item.subtitle %></span>
                <% end %>
              </div>
              <%= render FlatPack::Badge::Component.new(
                text: item.type == :screen ? "Screen" : "Section",
                style: item.type == :screen ? :info : :default,
                size: :sm
              ) %>
            </div>
          <% end %>
        <% end %>
      <% end %>
    </div>
  <% end %>

  <p
    data-admin--root-search-target="emptyState"
    class="text-sm text-(--surface-muted-content-color)"
    <%= "hidden" unless admin_search_query.present? && matching_admin_search_results.zero? %>
  >No admin screens or sections match that search.</p>
</div>

<% if admin_sections.any? %>
  <%= render FlatPack::List::Component.new(divider: true, class: "w-full") do %>
    <% admin_sections.each do |section| %>
      <% item_options = { href: preserve_anchor_url(section.url), hover: true } %>
      <% if section.icon.present? %>
        <% item_options[:leading] = render(FlatPack::Shared::IconComponent.new(name: section.icon, size: :md, class: "text-[var(--surface-muted-content-color)]")) %>
      <% end %>
      <%= render FlatPack::List::Item.new(**item_options) do %>
        <div class="flex flex-col gap-1">
          <span><%= section.title %></span>
          <% if section.subtitle.present? %>
            <span class="text-sm text-(--surface-muted-content-color)"><%= section.subtitle %></span>
          <% end %>
        </div>
      <% end %>
    <% end %>
  <% end %>
<% else %>
  <p class="text-sm text-(--surface-muted-content-color)">No admin sections are available.</p>
<% end %>
