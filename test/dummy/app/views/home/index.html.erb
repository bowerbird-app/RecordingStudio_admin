<div class="mx-auto flex w-full max-w-6xl flex-col gap-6">
  <% page_title_text = if @admin_root_home
                         "Admin Root Home"
                       else
                         "Workspace Home"
                       end %>
  <% page_subtitle_text = if @admin_root_home
                            "You are viewing admin-root specific controls and navigation."
                          else
                            "Quickly create admin screens and dashboards using recording studio"
                          end %>

  <%= render FlatPack::PageTitle::Component.new(
    title: page_title_text,
    subtitle: page_subtitle_text,
    variant: :h1
  ) do |page_title| %>
    <% page_title.slot do %>
      <%= render FlatPack::ButtonGroup::Component.new do |group| %>
        <% if @admin_root_home %>
          <% group.button(render(FlatPack::Button::Component.new(text: "Admin", url: "#{request.base_url}/admin/root?anchor_url=#{ERB::Util.url_encode(root_url)}", style: :primary))) %>
        <% else %>
          <% group.button(render(FlatPack::Button::Component.new(text: "Stats", url: "#{request.base_url}/stats/root?anchor_url=#{ERB::Util.url_encode(root_url)}", style: :primary))) %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
</div>
