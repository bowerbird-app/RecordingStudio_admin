<div class="mx-auto flex w-full max-w-6xl flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Recording Studio Admin Demo",
    subtitle: "Quickly create admin screens and dashboards using recording studio",
    variant: :h1
  ) do |page_title| %>
    <% page_title.slot do %>
      <%= render FlatPack::ButtonGroup::Component.new do |group| %>
        <% group.button(render(FlatPack::Button::Component.new(text: "Admin", url: "#{request.base_url}/admin/root?anchor_url=#{ERB::Util.url_encode(root_url)}", style: :secondary))) %>
        <% group.button(render(FlatPack::Button::Component.new(text: "Admin section dashboard", url: "#{request.base_url}/admin?anchor_url=#{ERB::Util.url_encode(root_url)}", style: :secondary))) %>
      <% end %>
    <% end %>
  <% end %>
</div>
