<%= render layout: "recording_studio_admin/shared/page_shell" do %>
  <% recording_studio_page_nav(
       title: t("recording_studio.admin.sections.index.title"),
       page_nav_anchor_url: page_nav_anchor_url(default: RecordingStudioAdmin.configuration.default_mount_path)
     ) %>
  <%= render "recording_studio_admin/shared/page_nav" unless recording_studio_admin_default_layout? %>

  <%= render FlatPack::PageTitle::Component.new(
        title: t("recording_studio.admin.sections.index.title"),
        subtitle: t("recording_studio.admin.sections.index.subtitle")
      ) %>

  <%= turbo_frame_tag "admin-sections-discovery" do %>
  <div class="space-y-4">
    <% search_query_params = request.query_parameters.symbolize_keys.slice(:anchor_url, :q) %>
    <% search_type_url = lambda do |type|
         query = search_query_params.dup
         query[:type] = type unless type == "all"
         query.any? ? "#{request.path}?#{query.to_query}" : request.path
       end %>

    <form
      action="<%= request.path %>"
      method="get"
      class="space-y-4"
      data-controller="flat-pack--auto-submit"
      data-turbo-frame="admin-sections-discovery"
      data-action="input->flat-pack--auto-submit#queueSubmit"
    >
      <% if params[:anchor_url].present? %>
        <%= hidden_field_tag :anchor_url, params[:anchor_url] %>
      <% end %>

      <% if @search_type != "all" %>
        <%= hidden_field_tag :type, @search_type %>
      <% end %>

      <%= render FlatPack::SearchInput::Component.new(
        name: :q,
        value: @search_query,
        placeholder: t("recording_studio.admin.sections.index.search_placeholder")
      ) %>
    </form>

    <%= render FlatPack::ButtonGroup::Component.new do |group| %>
      <% group.button(render(FlatPack::Button::Component.new(text: t("recording_studio.admin.sections.index.filter_all"), href: search_type_url.call("all"), style: (@search_type == "all" ? :primary : :secondary), data: { turbo_frame: "admin-sections-discovery" }))) %>
      <% group.button(render(FlatPack::Button::Component.new(text: t("recording_studio.admin.sections.index.filter_sections"), href: search_type_url.call("sections"), style: (@search_type == "sections" ? :primary : :secondary), data: { turbo_frame: "admin-sections-discovery" }))) %>
      <% group.button(render(FlatPack::Button::Component.new(text: t("recording_studio.admin.sections.index.filter_screens"), href: search_type_url.call("screens"), style: (@search_type == "screens" ? :primary : :secondary), data: { turbo_frame: "admin-sections-discovery" }))) %>
    <% end %>

    <% if @search_query.present? %>
      <% if @matching_admin_items.any? %>
        <div class="space-y-4">
          <% @search_result_groups.each do |grouping| %>
            <div class="space-y-2">
              <h3 class="text-sm font-semibold uppercase tracking-wide text-(--surface-muted-content-color)"><%= grouping.fetch(:title) %></h3>

              <%= render FlatPack::List::Component.new(divider: true, class: "w-full") do %>
                <% grouping.fetch(:items).each do |item| %>
                  <% item_options = { href: preserve_anchor_url(item.url), hover: true } %>
                  <% if item.icon.present? %>
                    <% item_options[:leading] = render(FlatPack::Shared::IconComponent.new(name: item.icon, size: :md, class: "text-[var(--surface-muted-content-color)]")) %>
                  <% end %>
                  <%= render FlatPack::List::Item.new(**item_options) do %>
                    <div class="flex items-start justify-between gap-3">
                      <div class="flex min-w-0 flex-1 flex-col gap-1">
                        <span><%= item.title %></span>
                        <% if item.subtitle.present? %>
                          <span class="text-sm text-(--surface-muted-content-color)"><%= item.subtitle %></span>
                        <% end %>
                      </div>
                      <%= render FlatPack::Badge::Component.new(
                        text: item.type == :screen ? t("recording_studio.admin.sections.index.badge_screen") : t("recording_studio.admin.sections.index.badge_section"),
                        style: item.type == :screen ? :info : :default,
                        size: :sm
                      ) %>
                    </div>
                  <% end %>
                <% end %>
              <% end %>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="text-sm text-(--surface-muted-content-color)"><%= t("recording_studio.admin.sections.index.empty_search") %></p>
      <% end %>
    <% end %>
  </div>
  <% end %>

  <% if @sections.any? %>
    <%= render FlatPack::List::Component.new(divider: true, class: "w-full") do %>
      <% @sections.each do |section| %>
        <% item_options = { href: preserve_anchor_url(section.url), hover: true } %>
        <% if section.icon.present? %>
          <% item_options[:leading] = render(FlatPack::Shared::IconComponent.new(name: section.icon, size: :md, class: "text-[var(--surface-muted-content-color)]")) %>
        <% end %>
        <%= render FlatPack::List::Item.new(**item_options) do %>
          <div class="flex flex-col gap-1">
            <span><%= section.title %></span>
            <% if section.subtitle.present? %>
              <span class="text-sm text-(--surface-muted-content-color)"><%= section.subtitle %></span>
            <% end %>
          </div>
        <% end %>
      <% end %>
    <% end %>
  <% else %>
    <p class="text-sm text-(--surface-muted-content-color)"><%= t("recording_studio.admin.sections.index.empty") %></p>
  <% end %>
<% end %>
