<%= render FlatPack::PageNav::Component.new(anchor_url: page_nav_anchor_url(default: RecordingStudioAdmin.configuration.default_mount_path), class: "mb-4") %>

<%= render FlatPack::PageTitle::Component.new(title: @section.title, subtitle: @section.subtitle) %>

<% if @section.links.any? %>
  <%= render FlatPack::ButtonGroup::Component.new(class: "my-6 flex-wrap") do |group| %>
    <% @section.links.each do |link| %>
      <% group.button(render(FlatPack::Button::Component.new(text: link.text, url: preserve_anchor_url(link.url), style: link.style))) %>
    <% end %>
  <% end %>
<% end %>

<% if @section.widgets.any? %>
  <% compact_widgets, full_widgets = @section.widgets.partition { |widget| widget.view_variant == :chip } %>

  <% if compact_widgets.any? %>
    <%= render FlatPack::Grid::Component.new(cols: :auto, gap: :sm, class: "my-4") do %>
      <% compact_widgets.each do |widget| %>
        <%= render partial: "recording_studio_admin/shared/widget", locals: { widget: widget } %>
      <% end %>
    <% end %>
  <% end %>

  <% if full_widgets.any? %>
    <%= render FlatPack::Grid::Component.new(cols: :auto, gap: :md, class: (compact_widgets.any? ? "my-4" : "my-8")) do %>
      <% full_widgets.each do |widget| %>
        <%= render partial: "recording_studio_admin/shared/widget", locals: { widget: widget } %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
