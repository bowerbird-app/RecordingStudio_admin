<% filters.each do |filter| %>
  <% field_label = filter.options[:display_label].presence || filter.key.to_s.humanize %>
  <div class="<%= wrapper_class %>">
    <% if filter.type == :date_range %>
      <% date_range_presets = [
           {
             key: :last_30_days,
             label: t("recording_studio.admin.screens.filters.date_presets.last_30_days", default: "Last 30 days"),
             days: 31
           },
           *FlatPack::DateRangeInput::Component::DEFAULT_PRESET_KEYS.map do |key|
             english = RecordingStudioAdmin::Period::QUICK_PRESET_LABELS.fetch(key) { key.to_s.humanize }
             {
               key: key,
               label: t("recording_studio.admin.screens.filters.date_presets.#{key}", default: english)
             }
           end
         ] %>
      <%= render FlatPack::DateRangeInput::Component.new(
        start_name: filter.start_param,
        end_name: filter.end_param,
        start_value: filter.value&.start_date,
        end_value: filter.value&.end_date,
        label: field_label,
        presets: date_range_presets,
        preset_name: filter.preset_param.to_s
      ) %>
    <% else %>
      <% choice = RecordingStudioAdmin::Definitions::FilterDefinition %>
      <% select_options = Array(filter.options[:values] || filter.options[:options]).map { |entry|
           {
             label: choice.choice_label(entry),
             value: choice.choice_value(entry)
           }
         } %>
      <% select_search_options = filter.options.slice(:searchable, :search_mode, :search_param, :search_endpoint).compact %>
      <% if select_options.any? %>
        <%= render FlatPack::Select::Component.new(
          name: filter.param_key,
          options: select_options,
          value: filter.value,
          label: field_label,
          placeholder: t("recording_studio.admin.screens.filters.all_placeholder", default: "All"),
          **select_search_options
        ) %>
      <% else %>
        <%= render FlatPack::SearchInput::Component.new(
          name: filter.param_key,
          value: filter.value,
          label: field_label,
          placeholder: field_label
        ) %>
      <% end %>
    <% end %>
  </div>
<% end %>
