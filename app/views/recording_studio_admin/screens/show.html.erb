<%= render FlatPack::PageTitle::Component.new(title: @screen.title, subtitle: @screen.subtitle) %>

<div class="flex flex-wrap gap-2 my-4">
  <% @screen.buttons.each do |button| %>
    <%= render FlatPack::Button::Component.new(text: button.text, href: button.url, style: button.style) %>
  <% end %>
</div>

<%= form_with url: request.path, method: :get, local: true, class: "flex flex-wrap gap-3 my-4" do |form| %>
  <% @screen.filters.each do |filter| %>
    <% if filter.type == :date_range %>
      <%= form.date_field :start_date, value: filter.value&.start_date, class: "rounded border px-3 py-2" %>
      <%= form.date_field :end_date, value: filter.value&.end_date, class: "rounded border px-3 py-2" %>
    <% else %>
      <%= form.select filter.key, Array(filter.options[:values] || filter.options[:options]).map { |value| [value.to_s.humanize, value] }, { include_blank: true, selected: filter.value }, class: "rounded border px-3 py-2" %>
    <% end %>
  <% end %>
  <%= render FlatPack::Button::Component.new(text: "Apply", type: :submit, style: :primary) %>
<% end %>

<% if @screen.chart %>
  <%= render FlatPack::Card::Component.new(style: :outlined, class: "my-4") do |card| %>
    <% card.with_body do %>
      <h2 class="text-lg font-semibold"><%= @screen.chart.title %></h2>
      <p class="text-sm text-[var(--surface-muted-content-color)]"><%= @screen.chart.subtitle %></p>
      <%= render FlatPack::Chart::Component.new(type: @screen.chart.type, series: @screen.chart.series, options: @screen.chart.options) %>
    <% end %>
  <% end %>
<% end %>

<% if @screen.table %>
  <%= render FlatPack::Table::Component.new(data: @screen.table.rows) do |table| %>
    <% @screen.table.columns.each do |column| %>
      <% table.with_column(column.title) { |row| column.cell(row, recording_studio_admin_context) } %>
    <% end %>
  <% end %>
  <div class="mt-4">
    <%= render FlatPack::Pagination::Component.new(current_page: @screen.table.result.current_page, total_pages: @screen.table.result.total_pages) %>
  </div>
<% end %>
