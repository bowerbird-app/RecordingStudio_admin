<% recording_studio_page_nav(
     title: @screen.title,
     page_nav_anchor_url: page_nav_anchor_url(default: RecordingStudioAdmin.configuration.default_mount_path)
   ) %>
<% if @screen.buttons.any? %>
  <% recording_studio_page_nav_right do %>
    <%= render FlatPack::ButtonGroup::Component.new do |group| %>
      <% @screen.buttons.each do |button| %>
        <% group.button(render(FlatPack::Button::Component.new(text: button.text, href: button.url, style: button.style))) %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
<%= render "recording_studio_admin/shared/page_nav" unless recording_studio_admin_default_layout? %>

<%= render FlatPack::PageTitle::Component.new(title: @screen.title, subtitle: @screen.subtitle) %>

<% if @screen.widgets.any? %>
  <% if RecordingStudioAdmin.configuration.async_widgets.enabled %>
    <div data-controller="recording-studio-admin--async-widgets"
         data-recording-studio-admin--async-widgets-max-concurrent-value="<%= RecordingStudioAdmin.configuration.async_widgets.max_concurrent_requests %>"
         data-recording-studio-admin--async-widgets-retry-count-value="<%= RecordingStudioAdmin.configuration.async_widgets.retry_count %>">
  <% end %>

    <%= render FlatPack::Grid::Component.new(cols: 3, gap: :md, class: "mb-6") do %>
      <% @screen.widgets.each do |widget| %>
        <% if RecordingStudioAdmin.configuration.async_widgets.enabled %>
          <%= render_recording_studio_async_widget_frame(widget, parent: :screen, parent_key: @screen.key, variant: :compact) %>
        <% else %>
          <%= render_recording_studio_widget(widget, variant: :compact) %>
        <% end %>
      <% end %>
    <% end %>

  <% if RecordingStudioAdmin.configuration.async_widgets.enabled %>
    </div>
  <% end %>
<% end %>

<% if @screen.filters.any? %>
  <% base_query = request.query_parameters.symbolize_keys.except(:page) %>
  <% modal_filters = @screen.filter_presentation == :modal %>
  <% filters_modal_id = "screen-filters-modal" %>
  <% filters_form_id = "screen-filters-form" %>
  <% filter_param_keys = @screen.filters.flat_map do |filter|
       if filter.type == :date_range
         [filter.start_param, filter.end_param, filter.preset_param]
       else
         [filter.param_key]
       end
     end.map(&:to_sym) %>
  <% hidden_query = base_query.except(*filter_param_keys) %>
  <% filter_fields = capture do %>
    <% @screen.filters.each do |filter| %>
     <div class="min-w-64 flex-none">
       <% if filter.type == :date_range %>
         <%= render FlatPack::DateRangeInput::Component.new(
           start_name: filter.start_param,
           end_name: filter.end_param,
           start_value: filter.value&.start_date,
           end_value: filter.value&.end_date
         ) %>
         <%= hidden_field_tag filter.preset_param, filter.value&.preset_key %>
       <% else %>
         <% select_options = Array(filter.options[:values] || filter.options[:options]).map { |value| { label: value.to_s.humanize, value: value } } %>
         <% select_search_options = filter.options.slice(:searchable, :search_mode, :search_param, :search_endpoint).compact %>
         <% if select_options.any? %>
           <%= render FlatPack::Select::Component.new(
             name: filter.param_key,
             options: select_options,
             value: filter.value,
             placeholder: "All",
             **select_search_options
           ) %>
         <% else %>
           <%= render FlatPack::SearchInput::Component.new(
             name: filter.param_key,
             value: filter.value,
             placeholder: filter.key.to_s.humanize
           ) %>
         <% end %>
       <% end %>
     </div>
    <% end %>
  <% end %>
  <% filter_form_data = {
      controller: [("flat-pack--auto-submit" unless modal_filters), "recording-studio-admin--screen-filters"].compact.join(" "),
      turbo_frame: "screen-chart",
      recording_studio_admin_screen_filters_modal_filters_value: modal_filters,
      action: [
        ("change->recording-studio-admin--screen-filters#showTableSkeletons" unless modal_filters),
        ("change->flat-pack--auto-submit#queueSubmit" unless modal_filters),
        ("input->recording-studio-admin--screen-filters#showTableSkeletons" unless modal_filters),
        ("input->flat-pack--auto-submit#queueSubmit" unless modal_filters),
        "submit->recording-studio-admin--screen-filters#showTableSkeletons",
        "submit->recording-studio-admin--screen-filters#refreshTableFrame",
        "click->recording-studio-admin--screen-filters#queueDateRangeSubmit"
      ].compact.join(" ")
     } %>
  <%= form_with url: request.path, method: :get, id: filters_form_id, data: filter_form_data do %>
    <% hidden_query.each do |key, value| %>
      <% if value.is_a?(Array) %>
        <% value.each do |entry| %>
          <%= hidden_field_tag "#{key}[]", entry %>
        <% end %>
      <% else %>
        <%= hidden_field_tag key, value %>
      <% end %>
    <% end %>

    <% if modal_filters %>
      <div class="mb-6">
        <%= render FlatPack::Button::Component.new(
          text: "Filters",
          icon: "funnel",
          style: :secondary,
          size: :md,
          data: { modal_id: filters_modal_id }
        ) %>
      </div>
      <%= render FlatPack::Modal::Component.new(id: filters_modal_id, title: "Filters", size: :md) do |modal| %>
        <% modal.body do %>
          <div class="flex flex-wrap items-start gap-4">
            <%= filter_fields %>
          </div>
        <% end %>
        <% modal.footer do %>
          <%= render FlatPack::Button::Component.new(
            text: "Apply",
            style: :primary,
            size: :md,
            type: "submit",
            form: filters_form_id,
            data: { action: "click->flat-pack--modal#close" }
          ) %>
        <% end %>
      <% end %>
    <% else %>
      <div class="mb-6 flex flex-wrap items-start gap-4">
        <%= filter_fields %>
      </div>
    <% end %>
  <% end %>
<% end %>

<% if @screen.has_chart %>
  <%= turbo_frame_tag "screen-chart", src: recording_studio_admin_screen_region_path(@screen.key, :chart) do %>
    <%= render FlatPack::Card::Component.new(style: :outlined, class: "mb-6") do |card| %>
      <% card.body do %>
        <div class="space-y-4">
          <%= render FlatPack::Skeleton::Component.new(variant: :text, width: "12rem", shimmer: true) %>
          <%= render FlatPack::Skeleton::Component.new(variant: :rectangle, height: "18rem", shimmer: true) %>
        </div>
      <% end %>
    <% end %>
  <% end %>
<% end %>

<% if @screen.has_table %>
  <%= turbo_frame_tag "screen-table", src: recording_studio_admin_screen_region_path(@screen.key, :table) do %>
    <%= render "table_placeholder", screen: @screen %>
  <% end %>
<% end %>
