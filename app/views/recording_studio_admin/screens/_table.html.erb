<% table_result = screen.table.result %>
<% current_sort = table_result&.sort.to_s %>
<% current_direction = table_result&.direction.to_s.presence || "desc" %>
<% base_query = request.query_parameters.symbolize_keys.except(:page) %>
<% column_picker_query = base_query.except(:columns, :columns_present) %>
<% reset_columns_query = column_picker_query.except(:anchor_url) %>
<% reset_columns_query[:anchor_url] = column_picker_query[:anchor_url] if reset_columns_query.any? && column_picker_query[:anchor_url].present? %>
<% reset_columns_url = reset_columns_query.any? ? "#{request.path}?#{reset_columns_query.to_query}" : request.path %>
<% columns_modal_id = "screen-table-columns-modal" %>
<% columns_form_id = "screen-table-columns-form" %>
<% selected_column_keys = screen.table.selected_column_keys %>
<% export_options = screen.table.export_options || {} %>
<% export_config = screen.table.export_config %>
<% token_export_available = export_config.present? &&
  recording_studio_admin_token_export_available?(screen.key) %>
<% export_button_available = (screen.table.export_key.present? ||
  token_export_available) &&
  recording_studio_admin_exportable_available? &&
  recording_studio_admin_context.access_recording.present? %>
<% export_filter_query = base_query.except(:columns, :columns_present, :anchor_url) %>
<% export_token = if export_button_available && token_export_available
     recording_studio_admin_export_token(
       screen_key: screen.key,
       columns: selected_column_keys,
       filters: export_filter_query
     )
   end %>
<% legacy_export_authorized = screen.table.export_key.present? &&
  recording_studio_admin_export_authorized?(screen.table.export_key, screen.key) %>
<% export_button_authorized = export_button_available && (export_token.present? || legacy_export_authorized) %>
<% has_more_rows = table_result&.has_more %>
<% next_page_url = if has_more_rows
     query = base_query.merge(page: table_result.current_page + 1)
  recording_studio_admin_screen_region_path(screen.key, :table, query: query)
   end %>
<% cell_content = lambda do |column, row|
     RecordingStudioAdmin::TableCellRenderer.call(
       column: column,
       row: row,
       context: recording_studio_admin_context,
       view_context: self
     )
   end %>
<% skeleton_width_for = lambda do |column|
     case column.key.to_s
     when "created_at", /_at\z/
       "8rem"
     when "email"
       "70%"
     when "status"
       "5rem"
     when "action"
       "7rem"
     else
       "55%"
     end
   end %>
<% filter_loading_cell = lambda do |content, width:|
     tag.span(
       safe_join([
         tag.span(content, class: "block", data: { recording_studio_admin_table_cell_content: true }),
         tag.span(
           render(FlatPack::Skeleton::Component.new(variant: :text, width: width, shimmer: true)),
           class: "pointer-events-none absolute inset-y-0 left-0 hidden w-full items-center",
           data: { recording_studio_admin_table_cell_skeleton: true },
           aria: { hidden: true }
         )
       ]),
       class: "relative block min-h-4"
     )
   end %>

<% selectable_columns = screen.table.available_columns.reject do |column|
     key = column.key.to_s.strip.downcase
     title = column.title.to_s.strip.downcase

     %w[action actions].include?(key) || %w[action actions].include?(title)
   end %>

<div data-controller="recording-studio-admin--screen-filters">
  <div class="mb-4 flex items-center justify-between gap-3">
    <div>
      <% if screen.table.title %>
        <h3 class="text-lg font-semibold text-(--surface-content-color)"><%= screen.table.title %></h3>
      <% end %>
      <% if screen.table.show_count && table_result %>
        <%= turbo_frame_tag "screen-table-count", src: (recording_studio_admin_screen_region_path(screen.key, :table_count, query: base_query) if table_result.count_pending) do %>
          <p class="mt-1 text-sm text-(--surface-muted-content-color)">
            <%= table_result.count_pending ? "Counting rows..." : pluralize(table_result.total_count, "row") %>
          </p>
        <% end %>
      <% end %>
    </div>

    <% columns_button_visible = screen.table.show_columns_button && selectable_columns.many? %>
    <% if columns_button_visible || export_button_available %>
      <div class="flex items-center gap-2">
        <% if export_button_available %>
          <% if export_button_authorized %>
            <% if export_token.present? %>
              <%= form_with url: recording_studio_admin_exportable_exports_path, method: :post, data: { turbo: false } do %>
                <%= hidden_field_tag :export_token, export_token %>
                <%= hidden_field_tag :format, export_options[:format] || :csv %>
                <% export_filter_query.each do |key, value| %>
                  <% if value.is_a?(Array) %>
                    <% value.each do |entry| %>
                      <%= hidden_field_tag "filters[#{key}][]", entry %>
                    <% end %>
                  <% else %>
                    <%= hidden_field_tag "filters[#{key}]", value %>
                  <% end %>
                <% end %>
                <%= render FlatPack::Button::Component.new(
                  text: export_options.fetch(:text, "Export"),
                  icon: export_options.fetch(:icon, "arrow-down-tray"),
                  type: "submit",
                  style: export_options.fetch(:style, :secondary),
                  size: export_options.fetch(:size, :md)
                ) %>
              <% end %>
            <% elsif respond_to?(:recording_studio_export_button) %>
              <%= recording_studio_export_button(
                context_recording: recording_studio_admin_context.access_recording,
                export_key: screen.table.export_key,
                columns: selected_column_keys,
                filters: export_filter_query,
                attributes: { screen_key: screen.key },
                text: export_options.fetch(:text, "Export"),
                icon: export_options.fetch(:icon, "arrow-down-tray"),
                style: export_options.fetch(:style, :secondary),
                size: export_options.fetch(:size, :md),
                data: { turbo: false }
              ) %>
            <% end %>
          <% else %>
            <%= render FlatPack::Button::Component.new(
              text: export_options.fetch(:unauthorized_text, "Export restricted"),
              icon: export_options.fetch(:icon, "arrow-down-tray"),
              style: export_options.fetch(:style, :secondary),
              size: export_options.fetch(:size, :md),
              disabled: true,
              aria: { disabled: true }
            ) %>
          <% end %>
        <% end %>

        <% if columns_button_visible %>
          <%= render FlatPack::Button::Component.new(
            text: "Columns",
            icon: "table-cells",
            style: :secondary,
            size: :md,
            data: {
              modal_id: columns_modal_id
            },
            aria: {
              label: "Choose table columns"
            }
          ) %>
        <% end %>
      </div>
    <% end %>
  </div>

  <% if columns_button_visible %>
    <%= render FlatPack::Modal::Component.new(id: columns_modal_id, title: "Table columns", size: :sm) do |modal| %>
      <% modal.body do %>
        <%= form_with url: recording_studio_admin_screen_region_path(screen.key, :table, query: {}), method: :get, id: columns_form_id, data: { turbo_frame: "screen-table" } do %>
          <% column_picker_query.each do |key, value| %>
            <% if value.is_a?(Array) %>
              <% value.each do |entry| %>
                <%= hidden_field_tag "#{key}[]", entry %>
              <% end %>
            <% else %>
              <%= hidden_field_tag key, value %>
            <% end %>
          <% end %>

          <%= hidden_field_tag :columns_present, "1" %>

          <div class="space-y-2">
            <% selectable_columns.each do |column| %>
              <%= render FlatPack::Checkbox::Component.new(
                name: "columns[]",
                value: column.key,
                checked: selected_column_keys.include?(column.key.to_s),
                label: column.title
              ) %>
            <% end %>
          </div>
        <% end %>
      <% end %>

      <% modal.footer do %>
        <%= render FlatPack::Button::Component.new(
          text: "Reset",
          style: :default,
          size: :md,
          url: reset_columns_url,
          data: {
            turbo_frame: "screen-table",
            action: "click->recording-studio-admin--screen-filters#showTableSkeletons"
          }
        ) %>

        <%= render FlatPack::Button::Component.new(
          text: "Apply",
          style: :primary,
          size: :md,
          type: "submit",
          form: columns_form_id,
          data: {
            action: "click->flat-pack--modal#close click->recording-studio-admin--screen-filters#showTableSkeletons"
          }
        ) %>
      <% end %>
    <% end %>
  <% end %>

  <%= render FlatPack::Table::Component.new(
    data: screen.table.rows,
    class: "text-sm",
    tbody_data: ({ pagination_content: true } if table_result&.mode.to_sym == :infinite)
  ) do |table| %>
    <% screen.table.columns.each do |column| %>
      <% next_direction = current_sort == column.key.to_s && current_direction == "asc" ? "desc" : "asc" %>
      <% sort_query = base_query.merge(sort: column.key, direction: next_direction) %>
      <% sort_url = recording_studio_admin_screen_region_path(screen.key, :table, query: sort_query) %>
      <% sort_indicator = if current_sort == column.key.to_s
           current_direction == "asc" ? " ↑" : " ↓"
         else
           ""
         end %>
      <% title = if column.sortable
           link_to("#{column.title}#{sort_indicator}", sort_url,
                   data: {
                     turbo_frame: "screen-table",
                     action: "click->recording-studio-admin--screen-filters#showTableSkeletons"
                   },
                   class: "inline-flex items-center gap-1 hover:text-[var(--table-sort-link-hover-color)] transition-colors")
         else
           column.title
         end %>
      <% if column.header_tooltip.present? %>
        <% title = render FlatPack::Tooltip::Component.new(text: column.header_tooltip, class: "inline-flex") do %>
          <%= title %>
        <% end %>
      <% end %>
      <% table.column(title: title, html: ->(row) do
           content = cell_content.call(column, row)
           tooltip = column.tooltip_for(row, recording_studio_admin_context)

           if tooltip.present?
             content = render FlatPack::Tooltip::Component.new(text: tooltip, class: "inline-flex") do
               concat(content)
             end
           else
             content
           end

           filter_loading_cell.call(content, width: skeleton_width_for.call(column))
         end) %>
    <% end %>

    <% if screen.table.actions.any? %>
      <% table.column(title: "Actions", html: ->(row) do
           actions = screen.table.actions.filter_map { |action| action.resolve(row, recording_studio_admin_context) }
           next if actions.empty?

           action_label = if row.respond_to?(:email) && row.email.present?
                            "Actions for #{row.email}"
                          elsif row.respond_to?(:id) && row.id.present?
                            "Actions for row #{row.id}"
                          else
                            "Row actions"
                          end

           dropdown = FlatPack::Button::Dropdown::Component.new(
             text: nil,
             icon: "ellipsis-vertical",
             style: :ghost,
             size: :sm,
             show_chevron: false,
             trigger_attributes: { aria: { label: action_label } }
           )

           actions.each do |action|
             item_options = {
               text: action.text,
               icon: action.icon,
               href: preserve_anchor_url(action.url),
               destructive: action.destructive
             }

             data_attributes = {}
             data_attributes[:turbo_method] = action.method if action.method.present?
             data_attributes[:turbo_confirm] = action.confirm if action.confirm.present?
             item_options[:data] = data_attributes if data_attributes.any?

             dropdown.menu_item(**item_options.compact)
           end

           filter_loading_cell.call(tag.div(render(dropdown), class: "flex justify-start"), width: "2.5rem")
         end) %>
    <% end %>
  <% end %>

  <% if table_result&.mode.to_sym == :infinite %>
    <% if has_more_rows %>
      <%= render FlatPack::Pagination::Component.new(
        mode: :infinite,
        infinite_url: next_page_url,
        has_more: has_more_rows,
        loading_variant: :inline
      ) %>
    <% else %>
      <div class="mt-4 flex justify-center">
        <%= render FlatPack::Badge::Component.new(text: "End") %>
      </div>
    <% end %>
  <% end %>
</div>