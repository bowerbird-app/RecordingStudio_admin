<% compact_card = widget.view_variant == :chip %>

<%= render FlatPack::Card::Component.new(style: :outlined) do |card| %>
    <% card.body do %>
      <% change_tone = RecordingStudioAdmin::WidgetChangeSemantics.tone(
        change: widget.change,
        good_when: widget.change_good_when
      ) %>
      <% change_text_class = case change_tone
                             when :success
                               "text-[var(--color-success-background-color)]"
                             when :danger
                               "text-[var(--color-danger-background-color)]"
                             else
                               "text-[var(--surface-muted-content-color)]"
                             end %>
      <% raw_subtitle = widget.subtitle %>
      <% period_label = widget.metadata&.[](:period_label).presence || widget.metadata&.[]("period_label").presence %>
      <% unit_label = widget.metadata&.[](:unit_label).presence || widget.metadata&.[]("unit_label").presence %>
      <% unless compact_card %>
        <% if period_label.present? && unit_label.blank? && raw_subtitle.present? && widget.value.present? %>
          <% unit_label = raw_subtitle %>
        <% elsif period_label.blank? && unit_label.blank? && raw_subtitle.present? && (widget.value.present? || widget.change.present?) %>
          <% period_label = raw_subtitle %>
        <% end %>
      <% end %>
      <% header_subtitle = if raw_subtitle.present? && raw_subtitle != unit_label && raw_subtitle != period_label
                             raw_subtitle
                           end %>

      <% if compact_card %>
        <div class="space-y-1">
          <% if widget.title.present? %>
            <h3 class="text-sm font-semibold"><%= widget.title %></h3>
          <% end %>

          <% if widget.value.present? %>
            <p class="flex flex-wrap items-baseline gap-1 leading-none">
              <span class="text-2xl font-bold"><%= widget.value %></span>
              <% if unit_label.present? %>
                <span class="text-xs text-(--surface-muted-content-color)"><%= unit_label %></span>
              <% end %>
            </p>
          <% end %>

          <% if widget.change.present? || period_label.present? %>
            <p class="flex items-center gap-1">
              <% if widget.change.present? %>
                <span class="text-xs font-semibold <%= change_text_class %>"><%= widget.change %></span>
              <% end %>
              <% if period_label.present? %>
                <span class="text-xs font-semibold text-(--surface-muted-content-color)"><%= period_label %></span>
              <% end %>
            </p>
          <% end %>
        </div>
      <% else %>
        <div class="space-y-4">
          <% if header_subtitle.present? || unit_label.present? || widget.title.present? || widget.value.present? || widget.change.present? || widget.link_to.present? || period_label.present? %>
            <div class="flex items-start justify-between gap-3">
              <% if header_subtitle.present? || unit_label.present? || widget.title.present? || widget.value.present? || widget.change.present? || period_label.present? %>
                <div class="space-y-2">
                  <% if widget.title.present? %>
                    <% if widget.description.present? %>
                      <%= render FlatPack::Tooltip::Component.new(text: widget.description) do %>
                        <h3 class="text-xl font-semibold"><%= widget.title %></h3>
                      <% end %>
                    <% else %>
                      <h3 class="text-xl font-semibold"><%= widget.title %></h3>
                    <% end %>
                  <% end %>
                  <% if header_subtitle.present? && !widget.value.present? && !widget.change.present? %>
                    <p class="text-sm text-(--surface-muted-content-color)"><%= header_subtitle %></p>
                  <% end %>
                  <% if widget.value.present? %>
                    <p class="flex flex-wrap items-baseline gap-2 leading-none">
                      <% if unit_label.present? %>
                        <%= render FlatPack::Tooltip::Component.new(text: unit_label) do %>
                          <span class="text-5xl font-bold"><%= widget.value %></span>
                        <% end %>
                      <% else %>
                        <span class="text-5xl font-bold"><%= widget.value %></span>
                      <% end %>
                    </p>
                  <% end %>
                  <% if widget.change.present? || period_label.present? %>
                    <p class="flex items-center gap-2">
                      <% if widget.change.present? %>
                        <span class="text-sm font-semibold <%= change_text_class %>"><%= widget.change %></span>
                      <% end %>
                      <% if period_label.present? %>
                        <span class="text-sm font-semibold text-(--surface-muted-content-color)"><%= period_label %></span>
                      <% end %>
                    </p>
                  <% end %>
                </div>
              <% end %>

              <% if widget.link_to.present? %>
                <% widget_screen_key = widget.key.to_s[/\A(.+)\.widgets\./, 1] || widget.link_to.to_s[%r{/screens/([^/?#]+)}, 1] %>
                <% widget_screen_name = begin
                     if widget_screen_key.present?
                       RecordingStudioAdmin.resolve_screen(key: widget_screen_key, context: recording_studio_admin_context).title
                     end
                   rescue RecordingStudioAdmin::DefinitionNotFound
                     nil
                   end %>
                <% widget_screen_name = widget_screen_name.presence || widget_screen_key.to_s.humanize.presence || "Admin screen" %>
                <div class="shrink-0">
                  <%= render FlatPack::Tooltip::Component.new(text: "Open #{widget_screen_name}") do %>
                    <%= render FlatPack::Button::Component.new(text: "More", url: preserve_anchor_url(widget.link_to), style: :secondary, size: :sm) %>
                  <% end %>
                </div>
              <% end %>
            </div>
          <% end %>

          <%= render partial: "recording_studio_admin/shared/widgets/#{widget.type}", locals: { widget: widget } %>
        </div>
      <% end %>
    <% end %>
  <% end %>
