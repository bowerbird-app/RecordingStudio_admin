<%= render FlatPack::Card::Component.new(style: :outlined) do |card| %>
  <% card.body do %>
    <div class="space-y-4">
      <% if widget.subtitle.present? || widget.title.present? %>
        <div class="space-y-2">
          <% if widget.subtitle.present? %>
            <p class="text-sm text-(--surface-muted-content-color)"><%= widget.subtitle %></p>
          <% end %>
          <% if widget.title.present? %>
            <h3 class="text-base font-semibold"><%= widget.title %></h3>
          <% end %>
        </div>
      <% end %>

      <%= render partial: "recording_studio_admin/shared/widgets/#{widget.type}", locals: { widget: widget } %>

      <% if widget.link_to.present? %>
        <%= render FlatPack::Button::Component.new(text: "View details", href: widget.link_to, style: :secondary) %>
      <% end %>
    </div>
  <% end %>
<% end %>
